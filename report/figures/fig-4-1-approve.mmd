flowchart TD
  start(["POST /api/cases/approve"]) --> lock["ถือล็อกการเขียนซึ่งมีเพียงตัวเดียว"]
  lock --> p1["ขั้นที่ 1 · ทรานแซกชันฝั่ง medcode<br/>รหัสที่ติ๊ก → case_codes<br/>ปิดเคส · เพิ่มแถวประวัติ"]
  p1 --> commit[("COMMIT medcode")]
  commit --> live["อ่านแถวปัจจุบันในระบบโรงพยาบาล"]
  live --> diff{"เทียบชุดรหัสสุดท้าย<br/>กับแถวปัจจุบัน"}
  diff -->|"ถูกนำออก"| del["ยกเลิก (W3/W4)"]
  diff -->|"เปลี่ยนแปลง"| put["แก้ไข (W2)"]
  diff -->|"ใหม่"| post["สร้าง (W1)"]
  del --> j["บันทึกข้อมูลก่อนเปลี่ยน<br/>imed_write_ops"]
  put --> j
  post --> j
  j --> st["coding_status = approved"]
  st --> done(["200 OK"])
  diff -.->|"เรียกระบบโรงพยาบาลไม่สำเร็จ"| err(["500: ฝั่ง medcode commit แล้ว<br/>อนุมัติอีกครั้ง การเทียบส่วนต่างจะแก้ให้ตรงกัน"])
