# Copy to `.env` and edit as needed. All values have sensible defaults.

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Embeddings (retrieval) ---
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu          # set to "cuda" if you have a GPU
COLLECTION_NAME=medcode

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=4

# --- Generation (tiny local LLM) ---
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LLM_DEVICE=cpu
MAX_NEW_TOKENS=512
TEMPERATURE=0.3
