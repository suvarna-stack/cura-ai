# Copy to `.env` — `docker compose` reads that file automatically.
# Every value here has a working default in docker-compose.yml; this file exists
# so you can change ports and secrets without editing the compose file.

# --- Published host ports -------------------------------------------------
# Defaults dodge the host ports that are normally busy on the dev Macs:
# 5432 (Homebrew Postgres 18) and 5173 (the vite dev server).
WEB_PORT=8080          # the app — open http://localhost:8080
API_PORT=8001          # medcode-api, direct (Swagger at /swagger-ui.html)
IMED_PORT=8003         # imed-mock-api (the fake hospital)
RAG_PORT=8000          # RAG service
DB_PORT=5433           # Postgres, for psql from the host

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Hospital API ---------------------------------------------------------
# Client credentials (hospital guide, 4 Nov 2026): medcode-api trades them for
# a short-lived Bearer token at POST {IMED_API_BASE}/auth/token. The mock
# accepts the same pair. The real pair comes from the hospital's admin when we
# point IMED_API_BASE at their server — keep the secret out of Git.
IMED_CLIENT_ID=medcode-mock-client
IMED_CLIENT_SECRET=medcode-mock-secret

# --- Backend --------------------------------------------------------------
# CHANGE THESE before anything reachable from outside your machine.
ADMIN_BOOTSTRAP_EMAIL=admin@medcodeai.demo
ADMIN_BOOTSTRAP_PASSWORD=admin1234
SESSION_TTL_DAYS=7
# "*" is fine here because nginx proxies /api on the same origin. Narrow it to
# your real web origin in any shared environment.
ALLOWED_ORIGINS=*
# Both are forced off inside the image; the demo stack turns them back on.
SWAGGER_ENABLED=true
DEMO_TOOLS_ENABLED=true

# --- RAG ------------------------------------------------------------------
# Generation runs on the HOST's Ollama app (no GPU passthrough in Docker on
# macOS). If host.docker.internal doesn't resolve, use your Mac's LAN IP:
#   OLLAMA_BASE=http://192.168.1.x:11434
LLM_BACKEND=ollama
OLLAMA_BASE=http://host.docker.internal:11434
OLLAMA_MODEL=hf.co/mradermacher/Llama-3.1-EIRAI-8B-i1-GGUF:Q4_K_M
# 0 keeps the ~2.3GB bge-m3 model out of the image: it downloads on first use
# into the hfcache volume, once, and survives rebuilds. Recommended on a laptop.
# 1 bakes it in — a ~3GB bigger image, but self-contained and offline-capable,
# which is what you want for a CI-built image or an offline hospital demo.
PREFETCH_EMBED_MODEL=0
