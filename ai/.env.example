# Copy to `.env` and edit as needed. All values have sensible defaults.

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Embeddings (retrieval) ---
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu          # set to "cuda" if you have a GPU
COLLECTION_NAME=medcode

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=4

# --- Generation (local LLM) ---
# Preferred backend: "ollama" — GGUF models with GPU offload via the Ollama
# app (https://ollama.com). Default model: Eir-8B, a Thai MEDICAL LLM.
#   ollama pull hf.co/mradermacher/Llama-3.1-EIRAI-8B-i1-GGUF:Q4_K_M
# Fallback backend: "transformers" — in-process CPU, no extra software.
LLM_BACKEND=ollama        # ollama | transformers
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=hf.co/mradermacher/Llama-3.1-EIRAI-8B-i1-GGUF:Q4_K_M
# transformers fallback (Thai general-purpose, CPU-sized):
LLM_MODEL=scb10x/llama3.2-typhoon2-1b-instruct
LLM_DEVICE=cpu            # set to "cuda" if you have a CUDA torch build
LLM_DTYPE=float32         # float32 | bfloat16 | float16 | auto (bf16 is slow on CPUs without native BF16)
MAX_NEW_TOKENS=512
TEMPERATURE=0.3

# --- Code suggestions (/suggest) ---
# SUGGEST_ENGINE=codebook          # or "rag" = old PDF scraping only
# SUGGEST_RAG_FALLBACK=true        # old search for a column the chart left empty
# SUGGEST_LLM_EXTRACT=auto         # auto = on when LLM_BACKEND=ollama | on | off
# SUGGEST_LLM_RERANK=auto
