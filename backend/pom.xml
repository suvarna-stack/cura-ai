<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.medcodeai</groupId>
	<artifactId>medcode-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>medcode-api</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- BCrypt only. Deliberately NOT spring-boot-starter-security: that
		     starter auto-locks every endpoint (401) and would break the public
		     case/approve/sync endpoints + their tests. spring-security-crypto
		     ships no autoconfiguration and no servlet filter — just the password
		     encoder. Auth enforcement is our own HandlerInterceptor scoped to the
		     admin routes. Version managed by Spring Boot's BOM. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!-- Swagger UI / OpenAPI. The 3.0.x line is the Spring Boot 4 one (2.8.x
		     is Boot 3); Boot's BOM doesn't manage springdoc, hence the version.
		     Disabled unless SWAGGER_ENABLED=true — see application.yml. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.0.3</version>
		</dependency>

		<!-- Schema migrations. db/migrations/V*.sql on the classpath is the ONLY
		     definition of every DDL change made after the frozen seed dump; before
		     Flyway the same statements were also hand-written in Java
		     (config/SchemaBootstrap), and the two copies had already drifted —
		     case_vitals and imed_write_ops lost the FK to cases that every other
		     child table carries.
		     THREE artifacts, all needed, all version-managed by Boot's BOM:
		      - spring-boot-flyway: Boot 4 split the autoconfigurations out of
		        spring-boot-autoconfigure into per-technology modules, so on Boot 4
		        flyway-core alone puts the LIBRARY on the classpath and nothing ever
		        calls it — the app boots, migrates nothing, and only fails later on
		        the first missing column. (Boot 3 needed only flyway-core.)
		      - flyway-core: the engine.
		      - flyway-database-postgresql: required separately since Flyway 10. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
